# Feature flag required to run any scenario.
ENABLE_THREAT_LAB=true

# Required Decoda staging URL (intentionally named per requirement).
DECUDA_BASE_URL=https://api.staging.decoda.ai

# Optional comma-separated staging host allow-list.
APPROVED_STAGING_DOMAINS=staging.decoda.ai,api.staging.decoda.ai,staging.decoda.internal

# Optional labels rendered in UI.
DEFAULT_WORKSPACES=staging-workspace-a,staging-workspace-b
DEFAULT_TARGETS=vault-alpha,wallet-monitoring,contract-risk

# Optional explicit lab wallets for testnet mode.
LAB_TARGET_WALLETS=0x1111111111111111111111111111111111111111,0x2222222222222222222222222222222222222222

# Optional testnet RPC used by helpers. Must not be mainnet.
TESTNET_RPC_URL=https://sepolia.infura.io/v3/replace-me

# Enables helper actions in testnet mode (simulated tx metadata).
TESTNET_HELPERS_ENABLED=true

# HTTP listening port.
PORT=3000
